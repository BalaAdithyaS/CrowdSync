# ==============================================================================
# CrowdSync - Unified Environment Configuration Example
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Local Development SQLite (default):
DATABASE_URL=sqlite:///./crowdsync.db

# Production Managed PostgreSQL (Neon, Supabase, Render, Railway, AWS RDS):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@ep-sample-12345.us-east-1.aws.neon.tech/crowdsync?sslmode=require
# Or standard PostgreSQL format:
# DATABASE_URL=postgresql://crowdsync_user:secret_password@localhost:5432/crowdsync_db

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# IMPORTANT: Generate a cryptographically secure random string in production:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=crowdsync-super-secret-jwt-key-for-dev-change-in-prod-xyz789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 3. CORS & DEPLOYED FRONTEND DOMAINS
# ------------------------------------------------------------------------------
# Comma-separated or JSON array of allowed origins for your deployed frontend.
# Example: https://crowdsync.vercel.app,https://yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000

# ------------------------------------------------------------------------------
# 4. APPLICATION & LOGGING SETTINGS
# ------------------------------------------------------------------------------
PROJECT_NAME=CrowdSync
API_V1_STR=/api
PORT=8000
DEMO_MODE=true

# Optional Redis connection for multi-worker scaling:
# REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 5. FRONTEND CONFIGURATION (For Vercel / Netlify / Cloudflare Pages)
# ------------------------------------------------------------------------------
# Leave empty if serving frontend and backend from the same domain or reverse proxy.
# Point to your deployed FastAPI backend URL if hosting frontend separately:
# VITE_API_URL=https://crowdsync-api.onrender.com
# VITE_WS_URL=wss://crowdsync-api.onrender.com
