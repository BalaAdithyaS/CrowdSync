# CrowdSync Frontend Environment Variables Example
# Copy to frontend/.env.local for local overrides or configure in your deployment platform (Vercel, Netlify, etc.)

# Backend API URL (leave empty for same-origin or reverse proxies; set for standalone cloud deployments)
# Example: https://crowdsync-api.onrender.com or https://api.crowdsync.app
VITE_API_URL=

# Optional dedicated WebSocket URL (defaults automatically to wss:// derived from VITE_API_URL)
# Example: wss://crowdsync-api.onrender.com
VITE_WS_URL=
